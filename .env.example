# Kopiér til .env. Uden .env bruges standardværdierne i docker-compose.yml.

# Hvilken adresse porten lyttes på på din maskine.
#   127.0.0.1 = kun denne maskine (standard)
#   0.0.0.0   = alle på netværket kan åbne den (ingen login!)
DND_BIND_IP=127.0.0.1

# Porten du åbner i browseren: http://<maskine>:<DND_PORT>
DND_PORT=8080

# Ejer af filerne i karakterer/. Find dine med: id -u  og  id -g
DND_UID=1000
DND_GID=1000

# LLM-endpoint til at generere korte danske beskrivelser af spells/feats/
# klassefeatures/race-traits, når vi ikke allerede har en (se
# webui/builder/descriptions.py). OpenAI-kompatibelt /chat/completions -
# virker fx med et claude-code-endpoint eller en Mistral-endpoint. Uden
# disse sat fejler kun selve "Generér beskrivelser"-knappen, ikke resten af byggeren.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
