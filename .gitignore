# Alt genereret (HTML og PDF) laves på ny med dnd.py og committes ikke.
karakterer/*/udskrifter/
*.tmp.html

__pycache__/
*.pyc
node_modules/
.venv/
.DS_Store

# Lokal konfiguration (port, bind-adresse, UID) — se .env.example
.env

# Karakterbyggerens kilde-indstillinger (hvilke 5etools-bøger må bruges) — lokalt pr. opsætning
webui/builder/settings.yaml

# Bogtekster og deres oversættelser (ophavsretsligt materiale; repoet er offentligt) — kun værktøjet i data/books/oversaettelse/ committes
data/books/*.json
data/books/5etools-*.json
data/books/oversaettelse/*/
data/feats.json

# Danske oversættelser af 5etools-opslagsfiler (bogtekster; ophavsretligt) — feats-da.json er undtaget, den er sporet
data/*-da.json
data/spells/
data/class/

# vol/ er runtime-data. karakterer/ er den gældende kopi; vol/karakterer var en forældet kopi.
# Homebrew-indhold er gruppens eget og skal ikke i det delte repo (kun index.json, der registrerer filerne).
vol/karakterer/
vol/simpelvtt/
vol/homebrew/*
!vol/homebrew/index.json

# Genereret opslagsfil til LLM-vejen (afledt af bogindhold; lav den med dnd.py llm-opslag)
llm-karakter-opslag.md
